{
  "name": "Swaasa Midha Dhyasa — Audio-Visual Mindfulness Sanctuary",
  "short_name": "Swaasa",
  "description": "Free open-source audio-visual mindfulness web app featuring science-backed breathing techniques, Indian Carnatic classical music, YouTube Music streaming, and customizable timers.",
  "id": "/breath/",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "orientation": "any",
